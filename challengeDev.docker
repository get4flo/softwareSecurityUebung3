FROM debian:latest@sha256:18023f131f52fc3ea21973cabffe0b216c60b417fd2478e94d9d59981ebba6af

WORKDIR /code

RUN apt update && apt install -y socat gdbserver

COPY ./homework .
COPY ./flag.txt .

# Launch gdbserver to listen for connections on port 1338
ENTRYPOINT socat TCP-LISTEN:1337,reuseaddr,fork EXEC:"gdbserver :1338 ./homework"